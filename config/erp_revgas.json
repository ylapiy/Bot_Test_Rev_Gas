{
  "_LEIA_ME": "MAPEAMENTO DA API DO RevGás — PRECISA SER PREENCHIDO COM A DOCUMENTAÇÃO OFICIAL. Os caminhos abaixo são SUPOSIÇÕES de exemplo. Para cada operação: metodo, caminho (use {variavel}), query, corpo, 'lista' (onde está a lista na resposta, ex.: 'data'; use '' se a resposta já é uma lista), 'item' (onde está o objeto) e 'mapa' (qual tradução de campos usar). Veja GUIA_DE_CONFIGURACAO.md, Etapa 5.",

  "endpoints": {
    "buscar_cliente_por_telefone": {"metodo": "GET", "caminho": "/clientes", "query": {"telefone": "{telefone}"}, "lista": "data", "mapa": "cliente"},
    "buscar_cliente_por_documento": {"metodo": "GET", "caminho": "/clientes", "query": {"cpf_cnpj": "{documento}"}, "lista": "data", "mapa": "cliente"},
    "cadastrar_cliente": {"metodo": "POST", "caminho": "/clientes", "corpo": {"nome": "{nome}", "cpf_cnpj": "{documento}", "telefone": "{telefone}"}, "mapa": "cliente"},
    "listar_enderecos": {"metodo": "GET", "caminho": "/clientes/{cliente_id}/enderecos", "lista": "data", "mapa": "endereco"},
    "cadastrar_endereco": {"metodo": "POST", "caminho": "/clientes/{cliente_id}/enderecos",
                           "corpo": {"logradouro": "{logradouro}", "numero": "{numero}", "complemento": "{complemento}", "bairro": "{bairro}", "cidade": "{cidade}", "cep": "{cep}", "referencia": "{referencia}"},
                           "mapa": "endereco"},
    "listar_produtos": {"metodo": "GET", "caminho": "/produtos", "lista": "data", "mapa": "produto"},
    "listar_filiais": {"metodo": "GET", "caminho": "/filiais", "lista": "data", "mapa": "filial"},
    "consultar_preco": {"metodo": "GET", "caminho": "/produtos/{produto_codigo}/preco", "query": {"filial": "{filial_id}"}, "mapa": "preco"},
    "consultar_estoque": {"metodo": "GET", "caminho": "/estoque", "query": {"produto": "{produto_codigo}", "filial": "{filial_id}"}, "lista": "data", "mapa": "estoque"},
    "criar_pedido": {"metodo": "POST", "caminho": "/pedidos", "corpo": "{pedido_json}", "mapa": "pedido"},
    "consultar_pedido": {"metodo": "GET", "caminho": "/pedidos/{numero}", "mapa": "pedido"},
    "listar_pedidos": {"metodo": "GET", "caminho": "/pedidos", "query": {"cliente_id": "{cliente_id}", "data_inicio": "{inicio}", "data_fim": "{fim}", "limite": "{limite}"}, "lista": "data", "mapa": "pedido"},
    "cancelar_pedido": {"metodo": "POST", "caminho": "/pedidos/{numero}/cancelar", "corpo": {"motivo": "{motivo}"}, "mapa": "pedido"},
    "listar_titulos": {"metodo": "GET", "caminho": "/financeiro/titulos", "query": {"cliente_id": "{cliente_id}"}, "lista": "data", "mapa": "titulo"},
    "segunda_via": {"metodo": "GET", "caminho": "/financeiro/titulos/{titulo_numero}/segunda-via", "mapa": "titulo"},
    "abrir_troca": {"metodo": "POST", "caminho": "/pos-venda/trocas", "corpo": {"cliente_id": "{cliente_id}", "pedido": "{pedido_numero}", "produto": "{produto_codigo}", "motivo": "{motivo}"}, "mapa": "troca"}
  },

  "mapas": {
    "cliente": {"id": "id", "nome": "nome", "tipo": "tipo_pessoa", "documento": "cpf_cnpj", "telefone": "telefone", "email": "email"},
    "endereco": {"id": "id", "logradouro": "logradouro", "numero": "numero", "complemento": "complemento", "bairro": "bairro", "cidade": "cidade", "cep": "cep", "referencia": "referencia", "principal": "principal"},
    "produto": {"codigo": "codigo", "nome": "descricao", "descricao": "descricao_longa", "categoria": "grupo", "unidade": "unidade"},
    "filial": {"id": "id", "nome": "nome", "bairros": "bairros_atendidos", "prazo_min": "prazo_entrega_min", "telefone": "telefone", "endereco": "endereco"},
    "preco": {"produto_codigo": "codigo", "produto_nome": "descricao", "filial_id": "filial.id", "filial_nome": "filial.nome", "preco": "preco_venda"},
    "estoque": {"filial_id": "filial_id", "filial_nome": "filial_nome", "quantidade": "saldo"},
    "pedido": {
      "numero": "numero", "cliente_id": "cliente.id", "status": "situacao", "filial_id": "filial.id", "filial_nome": "filial.nome",
      "endereco_texto": "entrega.endereco_formatado", "forma_pagamento": "pagamento.forma", "troco_para": "pagamento.troco_para",
      "itens": {"caminho": "itens", "mapa": "item"},
      "valor_produtos": "valor_produtos", "taxa_entrega": "valor_frete", "valor_total": "valor_total",
      "criado_em": "data_hora", "previsao_entrega": "entrega.previsao", "entregue_em": "entrega.data_entrega", "entregador": "entrega.entregador.nome"
    },
    "item": {"produto_codigo": "produto.codigo", "descricao": "produto.descricao", "quantidade": "quantidade", "preco_unit": "valor_unitario", "subtotal": "valor_total"},
    "titulo": {"numero": "numero", "cliente_id": "cliente_id", "pedido_numero": "pedido", "valor": "valor", "vencimento": "vencimento", "status": "situacao", "linha_digitavel": "linha_digitavel", "link": "url_boleto"},
    "troca": {"protocolo": "protocolo", "status": "situacao", "pedido_numero": "pedido", "produto_codigo": "produto"}
  },

  "status_pedido": {
    "ABERTO": "recebido", "RECEBIDO": "recebido", "EM_SEPARACAO": "em_separacao", "SEPARANDO": "em_separacao",
    "EM_ROTA": "em_rota", "SAIU_PARA_ENTREGA": "em_rota", "EM_ENTREGA": "em_rota",
    "ENTREGUE": "entregue", "FINALIZADO": "entregue", "CANCELADO": "cancelado"
  },

  "formas_pagamento": {"pix": "PIX", "dinheiro": "DINHEIRO", "cartao_debito": "CARTAO_DEBITO", "cartao_credito": "CARTAO_CREDITO", "boleto": "BOLETO"},

  "modelo_corpo_pedido": {
    "cliente_id": "{cliente_id}", "endereco_id": "{endereco_id}", "filial_id": "{filial_id}",
    "pagamento": {"forma": "{forma_pagamento}", "troco_para": "{troco_para}"},
    "observacao": "{observacao}", "origem": "{canal}"
  },
  "modelo_item_pedido": {"produto_codigo": "{produto_codigo}", "quantidade": "{quantidade}"},

  "bairros_por_filial": {
    "1": ["Centro", "Vila Nova", "Jardim América", "Boa Vista", "Consolação"],
    "2": ["Santana", "Tucuruvi", "Vila Maria", "Parque Novo Mundo", "Casa Verde"]
  }
}
