# =====================================================================
#  CHATBOT — CONFIGURAÇÃO
#  Copie para .env  (cp .env.example .env)  e preencha seguindo o
#  GUIA_DE_CONFIGURACAO.md. NUNCA envie o .env para o Git.
#  Deixando tudo como está, o bot já roda em modo DEMONSTRAÇÃO
#  (ERP fictício, sem IA, sem WhatsApp — use o simulador).
# =====================================================================

# ---------------- ETAPA 1: Empresa ----------------
EMPRESA_NOME=Gás Exemplo
BOT_NOME=Gabi
PRAZO_ENTREGA_MINUTOS=20
HORARIO_ATENDIMENTO_INICIO=08:00
HORARIO_ATENDIMENTO_FIM=20:00
# dias com atendente humano: seg,ter,qua,qui,sex,sab,dom
DIAS_ATENDIMENTO=seg,ter,qua,qui,sex,sab
FUSO_HORARIO=America/Sao_Paulo
# opcional: telefone de plantão para emergências fora do horário
TELEFONE_PLANTAO_EMERGENCIA=

# ---------------- ETAPA 2: Segurança do painel ----------------
# senha do painel do atendente (/atendente) e do simulador acessado de fora do servidor
PAINEL_ATENDENTE_SENHA=trocar-esta-senha
# em produção: false (ou proteja o acesso). O simulador permite "ser" qualquer telefone.
SIMULADOR_ATIVO=true

# ---------------- ETAPA 3: WhatsApp ----------------
# nenhum = só simulador | cloud = API oficial da Meta | evolution = ponte NÃO oficial (ver README)
WHATSAPP_PROVEDOR=nenhum
# false = SANDBOX: recebe o webhook mas NÃO envia nada para a Meta (respostas aparecem no simulador)
WHATSAPP_ENVIO_REAL=false
# Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta for Developers > seu app > Configurações do app > Básico > Chave secreta do aplicativo
WHATSAPP_APP_SECRET=
# você inventa (ex.: uma senha longa) e cola o MESMO valor na tela de webhook da Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
# template aprovado para avisos de status fora da janela de 24h (ex.: atualizacao_pedido)
WHATSAPP_TEMPLATE_STATUS_PEDIDO=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_MARCAR_COMO_LIDO=true

# Ponte temporária NÃO OFICIAL (Evolution API) — só use com aprovação (risco de banimento)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
EVOLUTION_WEBHOOK_TOKEN=

# ---------------- ETAPA 4: IA (opcional) ----------------
# auto = interpretação por IA quando disponível e menu guiado como alternativa
# legado = roteamento anterior por regras e uso opcional de agente com ferramentas
ATENDIMENTO_MODO=auto
# nenhum = atendimento guiado no modo auto | anthropic | openai (ou compatível)
LLM_PROVEDOR=nenhum
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic: padrão claude-sonnet-5-5 (respostas) e claude-haiku-5-5 (classificação). OpenAI: informe os modelos.
LLM_MODELO=
LLM_MODELO_RAPIDO=
LLM_TIMEOUT_SEGUNDOS=30
AGENTE_MAX_PASSOS=5
RERANK_COM_LLM=true

# Busca vetorial: local (grátis, já funciona) | openai (embeddings de verdade, melhor para sinônimos)
EMBEDDINGS_PROVEDOR=local
EMBEDDINGS_MODELO=text-embedding-3-small
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=

# ---------------- ETAPA 5: ERP RevGás ----------------
# mock = dados fictícios | revgas = API real (preencha config/erp_revgas.json)
ERP_MODO=mock
ERP_BASE_URL=
# bearer | apikey | basic
ERP_AUTH_TIPO=bearer
ERP_TOKEN=
ERP_APIKEY_HEADER=X-API-Key
ERP_USUARIO=
ERP_SENHA=
ERP_TIMEOUT_SEGUNDOS=15
# token que o ERP/app de entrega envia no cabeçalho X-Webhook-Token ao avisar mudança de status
ERP_WEBHOOK_TOKEN=

# ---------------- ETAPA 7: Text-to-SQL (consultas ao histórico) ----------------
# vazio = banco do ERP de demonstração. Produção: usuário SOMENTE LEITURA, ex.:
# postgresql+psycopg://bot_leitura:SENHA@host:5432/revgas   (exige: pip install sqlalchemy psycopg)
SQL_URL=
SQL_DIALETO=sqlite
SQL_TIMEOUT_SEGUNDOS=5

# ---------------- Atendimento humano ----------------
# opcional: URL que recebe um POST (JSON) a cada transferência (central de pedidos, Slack, n8n...)
HANDOFF_WEBHOOK_URL=
FALHAS_PARA_TRANSFERIR=2
HANDOFF_ESPERA_MAXIMA_MINUTOS=10

# ---------------- Memória ----------------
MEMORIA_EXPIRA_MINUTOS=60
MEMORIA_MAX_MENSAGENS=20
LOG_NIVEL=INFO
